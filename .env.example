# Cesium ion access token used by the RoofRay 3D Solar Site viewer.
# Create/copy the token from your Cesium ion account.
NEXT_PUBLIC_CESIUM_ION_TOKEN=

# Mappls Web SDK token for the RoofRay location map / 3D layer.
# Create a Mappls developer token and add it to your local environment.
NEXT_PUBLIC_MAPPLS_API_KEY=

# Server-side Mappls REST key for high-resolution static rooftop/aerial report imagery.
# Keep this secret; do NOT expose it as NEXT_PUBLIC_.
MAPPLS_REST_KEY=
